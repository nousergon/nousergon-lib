{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nousergon.ai/schemas/alpha-engine/arena_cycle.v1.json",
  "title": "Arena cycle — one champion/challenger evaluation of one slot",
  "description": "Emitted every cycle by nousergon_lib.arena.engine.run_cycle for every slot (universe cut, selection producer, model M, strategy S). Carries the full per-arm score ladder, every pairwise verdict with the common window it rests on, the pointer decision with its anytime-valid bound, and every retirement verdict including the ones that did NOT retire and why. Normative source: champion-challenger-policy.md.",
  "type": "object",
  "required": [
    "schema_version",
    "slot",
    "slot_kind",
    "benchmark",
    "as_of",
    "scored_arms",
    "active_arms",
    "ladders",
    "decision",
    "retirements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "slot": {"type": "string", "minLength": 1},
    "slot_kind": {"type": "string", "minLength": 1},
    "benchmark": {
      "type": "string",
      "minLength": 1,
      "description": "The population an arm is graded against. Default 'population' — the set the arm selected FROM. A selection-stage slot graded against SPY inverts wins and losses (measured 2026-08-17)."
    },
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scored_arms": {"type": "array", "items": {"type": "string"}},
    "active_arms": {"type": "array", "items": {"type": "string"}},
    "ladders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["arm_id", "as_of", "total_weeks", "total_dates", "total_misses", "rungs"],
        "properties": {
          "arm_id": {"type": "string"},
          "as_of": {"type": "string"},
          "total_weeks": {"type": "integer", "minimum": 0},
          "total_dates": {"type": "integer", "minimum": 0},
          "total_misses": {"type": "integer", "minimum": 0},
          "rungs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["weeks", "n_dates", "n_misses", "start_date", "end_date", "mean_score"],
              "properties": {
                "weeks": {"type": "integer", "minimum": 1},
                "n_dates": {"type": "integer", "minimum": 1},
                "n_misses": {"type": "integer", "minimum": 0},
                "start_date": {"type": "string"},
                "end_date": {"type": "string"},
                "mean_score": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "ranking": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["as_of", "evidence_mode", "cycles_present", "ordering", "standings", "verdicts"],
          "properties": {
            "as_of": {"type": "string"},
            "evidence_mode": {"enum": ["point", "anytime_valid"]},
            "cycles_present": {
              "type": "boolean",
              "description": "A Condorcet cycle in the pairwise beats-relation. When true, more arms than the cap may carry fewer than `cap` losses and the pool legitimately exceeds the cap for this cycle."
            },
            "ordering": {"type": "array", "items": {"type": "string"}},
            "standings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["arm_id", "wins", "losses", "ties", "unmeasurable", "copeland", "mean_margin", "created_date"],
                "properties": {
                  "arm_id": {"type": "string"},
                  "wins": {"type": "integer", "minimum": 0},
                  "losses": {"type": "integer", "minimum": 0},
                  "ties": {"type": "integer", "minimum": 0},
                  "unmeasurable": {"type": "integer", "minimum": 0},
                  "copeland": {"type": "integer"},
                  "mean_margin": {"type": "number"},
                  "created_date": {"type": "string"}
                }
              }
            },
            "verdicts": {"type": "array", "items": {"$ref": "#/$defs/pair"}}
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "required": ["slot", "as_of", "incumbent", "champion", "moved", "status", "reason", "comparisons", "ineligible"],
      "properties": {
        "slot": {"type": "string"},
        "as_of": {"type": "string"},
        "incumbent": {"type": ["string", "null"]},
        "champion": {"type": ["string", "null"]},
        "moved": {"type": "boolean"},
        "status": {
          "enum": ["decided", "held", "unmeasurable", "unservable", "bootstrap"],
          "description": "`unmeasurable` and `unservable` are explicit failure states carrying a reason. An empty comparison never renders as a pass (champion-challenger-policy.md §7.2)."
        },
        "reason": {"type": "string", "minLength": 1},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
        "ineligible": {
          "type": "object",
          "description": "Arms barred from SERVING by a hard precondition (M-slot behavioural veto, input completeness), regardless of ranking.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "passed", "reason"],
              "properties": {
                "name": {"type": "string"},
                "passed": {"type": "boolean"},
                "reason": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "retirements": {
      "type": "array",
      "description": "One verdict per active arm, INCLUDING the arms that were not retired and the reason each survived. A retirement list containing only retirements cannot be audited.",
      "items": {
        "type": "object",
        "required": ["arm_id", "retire", "reason", "age_weeks", "pairwise_losses", "is_champion"],
        "properties": {
          "arm_id": {"type": "string"},
          "retire": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1},
          "age_weeks": {"type": "integer", "minimum": 0},
          "pairwise_losses": {"type": "integer", "minimum": 0},
          "is_champion": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "required": ["n_dates", "weeks", "start_date", "end_date", "mean_diff", "unmeasurable_reason"],
      "description": "A head-to-head comparison on the two arms' own longest common window. `n_dates` and the window bounds are reported ALONGSIDE the metric — champion-challenger-policy.md §4 requires the intersection be visible, and it was being violated (2026-08-29: an incumbent scored over 2 dates defended against a challenger rejected for having 4).",
      "properties": {
        "arm_a": {"type": "string"},
        "arm_b": {"type": "string"},
        "challenger": {"type": "string"},
        "incumbent": {"type": "string"},
        "n_dates": {"type": "integer", "minimum": 0},
        "weeks": {"type": "integer", "minimum": 0},
        "start_date": {"type": ["string", "null"]},
        "end_date": {"type": ["string", "null"]},
        "mean_diff": {"type": ["number", "null"]},
        "unmeasurable_reason": {"type": ["string", "null"]},
        "winner": {"type": ["string", "null"]},
        "loser": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "reason": {"type": "string"},
        "supported": {"type": "boolean"},
        "confidence_sequence": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["mean", "lower", "upper", "radius", "n", "alpha", "sigma", "variance_mode", "method", "supported"],
              "properties": {
                "mean": {"type": "number"},
                "lower": {"type": "number"},
                "upper": {"type": "number"},
                "radius": {"type": "number", "minimum": 0},
                "n": {"type": "integer", "minimum": 1},
                "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                "sigma": {"type": "number", "minimum": 0},
                "variance_mode": {"enum": ["declared", "empirical"]},
                "method": {"type": "string"},
                "n_clipped": {"type": "integer", "minimum": 0},
                "supported": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  }
}
